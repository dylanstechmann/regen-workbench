# Copy to .env and fill in. Never commit .env. Never paste tokens into chats.

# Used as the contact address on NCBI / OpenAlex / UniProt polite pools.
EMAIL=you@university.edu

# Optional but strongly recommended. Free from https://www.ncbi.nlm.nih.gov/account/
# then https://www.ncbi.nlm.nih.gov/account/settings/  → API Key Management
NCBI_API_KEY=

# Optional OpenAlex API key for higher query limits.
OPENALEX_API_KEY=

# Optional. Only if you use NVIDIA NIM Boltz instead of open-source boltz.
NGC_API_KEY=

# Optional. Hugging Face token if a gated model is needed later.
HF_TOKEN=
