{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regen simulation toolchain manifest",
  "description": "A provenance record for a software-only simulation workflow; contains no experiment results or biological measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "claim_boundary",
    "steps",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 4
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 20
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "tool_repository",
          "tool_revision",
          "purpose",
          "execution_status",
          "input_artifacts",
          "output_artifacts"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 2
          },
          "tool_repository": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "tool_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 12
          },
          "execution_status": {
            "enum": [
              "not_run",
              "completed"
            ]
          },
          "input_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "repository",
          "path",
          "sha256",
          "size_bytes",
          "artifact_kind",
          "evidence_status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 2
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "artifact_kind": {
            "enum": [
              "protocol_constraints",
              "candidate_fixture",
              "well_measurement_fixture",
              "measurement_aggregation",
              "planner_observations",
              "planner_proposal",
              "oxygen_parameters",
              "oxygen_simulation",
              "synthetic_calibration_input",
              "synthetic_calibration_report"
            ]
          },
          "evidence_status": {
            "enum": [
              "software_fixture",
              "simulated",
              "synthetic_input"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    }
  }
}
